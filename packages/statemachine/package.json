{
  "name": "@vedmalex/statemachine",
  "version": "1.0.0-beta.5",
  "description": "Hierarchical state machine for TypeScript with monitoring, validation, and persistence (lite-only DI-free surface).",
  "keywords": [
    "state-machine",
    "statemachine",
    "hierarchical",
    "lite",
    "wasm-friendly"
  ],
  "author": "vedmalex (Vedanta-krit das)",
  "license": "MIT",
  "homepage": "https://github.com/vedmalex/statemachine#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vedmalex/statemachine.git",
    "directory": "packages/statemachine"
  },
  "bugs": {
    "url": "https://github.com/vedmalex/statemachine/issues"
  },
  "sideEffects": false,
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./types/index.d.ts",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./sim": {
      "types": "./types/sim/index.d.ts",
      "import": "./dist/sim/index.js",
      "require": "./dist/sim/index.cjs"
    }
  },
  "files": [
    "dist",
    "types",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "clean": "rm -rf dist types coverage tsconfig.tsbuildinfo",
    "build": "npm run clean && tsup && tsc -p tsconfig.build.json --emitDeclarationOnly",
    "build:types": "tsc -p tsconfig.build.json --emitDeclarationOnly",
    "lint": "biome check .",
    "typecheck": "tsc --noEmit",
    "typecheck:types": "tsc -p tsconfig.typecheck.json",
    "check": "biome check . && tsc --noEmit && knip --no-progress",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:cjs-smoke": "node test/cjs-smoke/smoke.cjs",
    "test:deno-smoke": "deno run -A test/deno-smoke.ts",
    "test:browser": "playwright test",
    "knip": "knip --no-progress",
    "api:check": "api-extractor run --local --verbose",
    "api:check:sim": "api-extractor run --local --config api-extractor.sim.json",
    "sim:coverage": "SM_SIM=1 vitest run src/tests/sim/sim-coverage.run.test.ts",
    "sim:perf": "SM_SIM=1 NODE_OPTIONS=--expose-gc vitest run src/tests/sim/metrics.perf.test.ts",
    "sim:perf:baseline": "SM_SIM=1 SM_PERF_UPDATE_BASELINE=1 NODE_OPTIONS=--expose-gc vitest run src/tests/sim/metrics.perf.test.ts",
    "sim:pr": "SM_SIM=1 vitest run src/tests/sim/sim-pr.run.test.ts",
    "sim:guards": "SM_SIM=1 vitest run src/tests/sim/wire_seam_forwarding.test.ts src/tests/sim/dist_byte_guard.test.ts src/tests/sim/tsconfig_isolation.test.ts",
    "sim:sweep": "SM_SIM=1 vitest run src/tests/sim/sim-sweep.run.test.ts",
    "verify-dist-bytes": "node test/verify-dist-bytes.cjs",
    "prepublishOnly": "npm run check && npm run build && node test/verify-dist.cjs && node test/verify-dist-bytes.cjs"
  },
  "dependencies": {},
  "peerDependencies": {},
  "devDependencies": {
    "@biomejs/biome": "2.4.14",
    "@changesets/cli": "^2.31.0",
    "@microsoft/api-extractor": "^7.58.7",
    "@playwright/test": "^1.59.1",
    "@types/bun": "^1.2.16",
    "@types/node": "^25.6.0",
    "@vitest/coverage-istanbul": "^4.1.5",
    "@vitest/coverage-v8": "^4.1.5",
    "knip": "^6.11.0",
    "tsup": "^8.5.1",
    "typedoc": "^0.28.19",
    "typescript": "^5.6.0",
    "vitest": "^4.1.5"
  },
  "publishConfig": {
    "access": "public"
  }
}
