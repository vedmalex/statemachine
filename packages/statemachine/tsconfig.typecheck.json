{
  // Typegate for path type-tests (V8 / critic W1). The base tsconfig.json:21
  // EXCLUDES `**/*.test.ts` and `src/tests/**`, so type errors inside tests are
  // invisible to `tsc`. This config includes the `*.test-d.ts` type-tests (which
  // are NOT matched by the `**/*.test.ts` exclusion) so they ARE typechecked,
  // WITHOUT pulling in the full `*.test.ts` suite (avoids the §0.6 avalanche).
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true
  },
  "include": ["src/**/*"],
  "exclude": [
    "node_modules",
    "dist",
    "types",
    "**/*.test.ts",
    "src/tests/sim",
    "src/tests/mocks.ts"
  ]
}
